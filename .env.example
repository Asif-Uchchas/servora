# ── Required ───────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, RDS, local…)
DATABASE_URL="postgresql://user:password@host:5432/servora?sslmode=require"
# Generate with: npx auth secret
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Billing (optional in development) ──────────────────────
# Without these, the Billing page explains how to enable upgrades.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Recurring monthly Price IDs from your Stripe dashboard
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# ── Public demo (optional) ─────────────────────────────────
# Shows "Try the live demo" on the landing page and a demo button on /login.
# Only set this for a dedicated demo workspace — anyone can sign in with it.
NEXT_PUBLIC_DEMO_EMAIL=""
NEXT_PUBLIC_DEMO_PASSWORD=""
